#!/usr/bin/bash
# Only immutable machine selection follows the OS version; never touch packages.
set -euo pipefail
version="${1:?missing host image version}"
[[ "${version}" =~ ^[0-9][0-9A-Za-z.]{0,16}$ ]] || exit 1
image="/var/lib/machines/homebrew_${version}.raw"
[ -f "${image}" ] || { printf 'Homebrew machine missing: %s\n' "${image}" >&2; exit 1; }
ln -sfn "homebrew_${version}.raw" /var/lib/machines/bluefin-homebrew.raw
