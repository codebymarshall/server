#!/usr/bin/python3
"""Prepare the fixed Homebrew machine without executing anything from its prefix."""
import argparse
import fcntl
import grp
import os
from pathlib import Path
import pwd
import re
import shutil
import stat
import subprocess
import sys
import tempfile
import time

STATE = Path("/var/lib/bluefin-homebrew")
RUN = Path("/run/bluefin-homebrew")
IMAGE = Path("/var/lib/machines/bluefin-homebrew.raw")


def run(*args, **kwargs):
    return subprocess.run(args, check=True, **kwargs)


def trusted(path):
    """Fail closed on writable/symlinked root-owned runtime/config paths."""
    path = Path(path)
    for part in [*reversed(path.parents), path]:
        info = part.lstat()
        if stat.S_ISLNK(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022:
            raise RuntimeError(f"Untrusted runtime path: {part}")
    return path


def atomic_text(path, content, mode=0o644):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=".bluefin-", dir=path.parent)
    try:
        with os.fdopen(fd, "w") as stream:
            stream.write(content)
        os.chmod(temporary, mode)
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def record_owner(state, uid, gid):
    value = f"{uid}:{gid}\n"
    path = state / "owner"
    if path.exists():
        if path.read_text() != value:
            raise RuntimeError("Homebrew prefix ownership is persistent; configured owner differs")
    else:
        atomic_text(path, value)


def seed_prefix(seed, prefix, uid, gid):
    if prefix.exists():
        return
    staging = Path(tempfile.mkdtemp(prefix=".prefix-", dir=prefix.parent))
    try:
        # Keep the owner-controlled copy behind root-only staging until publication.
        copy = staging / "prefix"
        shutil.copytree(seed, copy, symlinks=True)
        for directory, directories, files in os.walk(copy, followlinks=False):
            os.chown(directory, uid, gid)
            os.chmod(directory, stat.S_IMODE(os.stat(directory).st_mode) & ~0o022)
            for name in directories + files:
                os.chown(Path(directory) / name, uid, gid, follow_symlinks=False)
                path = Path(directory) / name
                if not path.is_symlink():
                    os.chmod(path, stat.S_IMODE(path.stat().st_mode) & ~0o022)
        os.replace(copy, prefix)
    finally:
        if staging.exists():
            shutil.rmtree(staging)


def prefix_executable(path, prefix):
    """Resolve only within the pinned prefix, never through a host-directory link."""
    relative = os.path.relpath(path, prefix)
    guest_prefix = "/home/linuxbrew/.linuxbrew/"
    for _ in range(40):
        if relative == ".." or relative.startswith("../") or relative.startswith("/"):
            return False
        fd = None
        try:
            fd = os.open(prefix, os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
            parts = relative.split("/")
            for index, part in enumerate(parts):
                info = os.stat(part, dir_fd=fd, follow_symlinks=False)
                if stat.S_ISLNK(info.st_mode):
                    target = os.readlink(part, dir_fd=fd)
                    if target.startswith(guest_prefix):
                        target = target[len(guest_prefix):]
                    elif target.startswith("/"):
                        return False
                    else:
                        target = os.path.join(*parts[:index], target)
                    relative = os.path.normpath(os.path.join(target, *parts[index + 1:]))
                    break
                if index == len(parts) - 1:
                    return stat.S_ISREG(info.st_mode) and bool(info.st_mode & 0o111)
                if not stat.S_ISDIR(info.st_mode):
                    return False
                child = os.open(part, os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=fd)
                os.close(fd)
                fd = child
        except OSError:
            return False
        finally:
            if fd is not None:
                os.close(fd)
    return False


def refresh_commands(prefix, commands, launcher):
    names = set()
    for directory in [prefix / "bin", prefix / "sbin"]:
        try:
            fd = os.open(directory, os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
        except OSError:
            continue
        try:
            for name in os.listdir(fd):
                if name != "brew" and prefix_executable(directory / name, prefix):
                    names.add(name)
        finally:
            os.close(fd)
    commands.mkdir(mode=0o755, parents=True, exist_ok=True)
    for entry in commands.iterdir():
        if entry.name not in names:
            entry.unlink()
    for name in names:
        target = commands / name
        if target.is_symlink() and os.readlink(target) == launcher:
            continue
        fd, filename = tempfile.mkstemp(prefix=".index-", dir=commands)
        os.close(fd)
        temporary = Path(filename)
        temporary.unlink()
        temporary.symlink_to(launcher)
        os.replace(temporary, target)


def credential(name):
    for directory in [os.environ.get("CREDENTIALS_DIRECTORY", "/run/credentials/bluefin-homebrew-prepare.service"),
                      "/run/credentials/@system"]:
        path = Path(directory) / name
        if path.is_file():
            return path.read_text().strip()
    return ""


def provision_owner_keys(owner):
    keys = credential(f"ssh.authorized_keys.{owner.pw_name}")
    if not keys:
        return
    child = os.fork()
    if child == 0:
        try:
            # User-controlled home paths are never traversed with root authority.
            os.setgroups(os.getgrouplist(owner.pw_name, owner.pw_gid))
            os.setgid(owner.pw_gid)
            os.setuid(owner.pw_uid)
            home = os.open(owner.pw_dir, os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
            try:
                try:
                    os.mkdir(".ssh", 0o700, dir_fd=home)
                except FileExistsError:
                    pass
                ssh = os.open(".ssh", os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=home)
            finally:
                os.close(home)
            try:
                os.fchmod(ssh, 0o700)
                fd, path = tempfile.mkstemp(prefix=".authorized-", dir=f"/proc/self/fd/{ssh}")
                temporary = Path(path).name
                try:
                    with os.fdopen(fd, "w") as stream:
                        stream.write(keys + "\n")
                        stream.flush()
                        os.fsync(stream.fileno())
                    os.replace(temporary, "authorized_keys", src_dir_fd=ssh, dst_dir_fd=ssh)
                    os.fsync(ssh)
                finally:
                    try:
                        os.unlink(temporary, dir_fd=ssh)
                    except FileNotFoundError:
                        pass
            finally:
                os.close(ssh)
        except Exception as error:
            print(f"Owner SSH key provisioning failed: {error}", file=sys.stderr, flush=True)
            os._exit(1)
        os._exit(0)
    _, status = os.waitpid(child, 0)
    if status != 0:
        raise RuntimeError("Owner SSH key provisioning failed")


def configuration():
    path = Path("/etc/bluefin-homebrew.conf")
    values = {}
    if path.exists():
        for line in trusted(path).read_text().splitlines():
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            key, separator, value = line.partition("=")
            if not separator or key not in {"OWNER", "PROJECT_ROOTS"}:
                raise ValueError("Expected OWNER=account or PROJECT_ROOTS=/absolute/path ...")
            values[key] = value.strip()
    return values


def login_users():
    return sorted((user for user in pwd.getpwall() if 1000 <= user.pw_uid < 65534
                   and user.pw_shell not in {"/usr/sbin/nologin", "/sbin/nologin", "/bin/false", "/usr/bin/false"}),
                  key=lambda user: user.pw_uid)


def select_owner(config):
    name = credential("bluefin.homebrew.owner") or config.get("OWNER", "")
    users = login_users()
    if not name and (STATE / "owner").exists():
        uid = int((STATE / "owner").read_text().split(":")[0])
        name = pwd.getpwuid(uid).pw_name
    if not name and users:
        name = users[0].pw_name
    if not name:
        while True:
            name = run("systemd-ask-password", "--timeout=0", "--echo=yes",
                       "Bluefin Home Server: non-root Homebrew owner account:", capture_output=True,
                       text=True).stdout.strip()
            if re.fullmatch(r"[a-z_][a-z0-9_-]{0,30}", name) and name != "root":
                break
            print("Use a nonroot account name: lowercase letters, digits, underscores or hyphens.", file=sys.stderr)
    if not re.fullmatch(r"[a-z_][a-z0-9_-]{0,30}", name) or name == "root":
        raise ValueError("Homebrew owner must be a valid non-root account name")
    try:
        user = pwd.getpwnam(name)
    except KeyError:
        # Credentials win discovery, including an explicitly requested new account.
        password_hash = credential(f"passwd.hashed-password.{name}")
        password = None
        if not password_hash:
            while True:
                password = run("systemd-ask-password", "--timeout=0",
                               f"Password for new Bluefin Homebrew owner {name}:",
                               capture_output=True, text=True).stdout.rstrip("\n")
                confirm = run("systemd-ask-password", "--timeout=0", "Confirm account password:",
                              capture_output=True, text=True).stdout.rstrip("\n")
                if password and password == confirm:
                    break
                print("Account passwords must be non-empty and match; try again.", file=sys.stderr)
        Path("/var/home").mkdir(mode=0o755, exist_ok=True)
        trusted(Path("/var/home"))
        run("useradd", "--create-home", "--home-dir", f"/var/home/{name}", "--shell", "/bin/bash", name)
        if password_hash:
            run("chpasswd", "--encrypted", input=f"{name}:{password_hash}\n", text=True)
        else:
            run("chpasswd", input=f"{name}:{password}\n", text=True)
        user = pwd.getpwnam(name)
    if not 1000 <= user.pw_uid < 65534:
        raise ValueError("Homebrew owner UID must be between 1000 and 65533")
    provision_owner_keys(user)
    return pwd.getpwnam(name)


def nspawn_bind(source, destination, readonly=False):
    for value in [source, destination]:
        if not value.startswith("/") or any(character in value for character in "\n\r:"):
            raise ValueError("Shared paths must be absolute without nspawn delimiters")
    return ("BindReadOnly=" if readonly else "Bind=") + source + ":" + destination


def pin_endpoint(user, engine):
    run("systemctl", "start", f"user-runtime-dir@{user.pw_uid}.service")
    source = f"/run/user/{user.pw_uid}/bluefin-{engine}"
    # Directory creation runs with the owner, never privileged through a writable
    # host runtime parent. Openat pins the directory, defeating replacement races.
    run("/usr/bin/setpriv", f"--reuid={user.pw_uid}", f"--regid={user.pw_gid}",
        "--init-groups", "--", "mkdir", "-p", "-m", "0700", "--", source)
    parent = os.open(f"/run/user/{user.pw_uid}", os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        fd = os.open(f"bluefin-{engine}", os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=parent)
    finally:
        os.close(parent)
    try:
        info = os.fstat(fd)
        if info.st_uid != user.pw_uid or info.st_mode & 0o077:
            raise RuntimeError("Host engine endpoint directory must be owner-only")
        target = RUN / "endpoints" / str(user.pw_uid) / engine
        target.mkdir(mode=0o755, parents=True, exist_ok=True)
        if os.path.ismount(target):
            run("umount", str(target))
        run("mount", "--no-canonicalize", "--bind", f"/proc/self/fd/{fd}", str(target), pass_fds=(fd,))
        return nspawn_bind(str(target), f"/run/bluefin-engines/{user.pw_uid}/{engine}", readonly=True)
    finally:
        os.close(fd)


def sync_accounts(etc, users):
    # Keep guest system accounts, discard the producer's linuxbrew UID 1001 and
    # every old interactive account before importing exact host IDs.
    for filename, key_index in [("passwd", 2), ("group", 2)]:
        path = etc / filename
        lines = [line for line in path.read_text().splitlines()
                 if line and int(line.split(":")[key_index]) < 1000 and line.split(":")[0] != "linuxbrew"]
        if filename == "passwd":
            for user in users:
                lines.append(f"{user.pw_name}:x:{user.pw_uid}:{user.pw_gid}:{user.pw_gecos}:{user.pw_dir}:/usr/bin/bash")
        else:
            gids = {user.pw_gid for user in users}
            for user in users:
                gids.update(os.getgrouplist(user.pw_name, user.pw_gid))
            for group in grp.getgrall():
                if group.gr_gid in gids:
                    lines = [line for line in lines if int(line.split(":")[2]) != group.gr_gid
                             and line.split(":")[0] != group.gr_name]
                    members = ",".join(user.pw_name for user in users
                                       if group.gr_gid in os.getgrouplist(user.pw_name, user.pw_gid))
                    lines.append(f"{group.gr_name}:x:{group.gr_gid}:{members}")
        atomic_text(path, "\n".join(lines) + "\n")
    shadow = etc / "shadow"
    base = shadow.read_text().splitlines() if shadow.exists() else []
    names = {line.split(":")[0] for line in (etc / "passwd").read_text().splitlines()}
    base = [line for line in base if line.split(":")[0] in names and line.split(":")[0] not in {u.pw_name for u in users}]
    day = int(time.time() // 86400)
    base.extend(f"{user.pw_name}:!:{day}:0:99999:7:::" for user in users)
    atomic_text(shadow, "\n".join(base) + "\n", 0o600)


def prepare_machine():
    config = configuration()
    owner = select_owner(config)
    record_owner(STATE, owner.pw_uid, owner.pw_gid)
    users = login_users()
    RUN.mkdir(mode=0o755, exist_ok=True)
    trusted(RUN)
    runtime_config = Path("/etc/bluefin-homebrew")
    runtime_config.mkdir(mode=0o755, exist_ok=True)
    trusted(runtime_config)
    with tempfile.TemporaryDirectory(prefix="image-", dir=RUN) as directory:
        mount = Path(directory)
        run("systemd-dissect", "--mount", "--read-only", str(IMAGE), str(mount))
        try:
            seed_prefix(mount / "usr/share/bluefin/homebrew-seed", STATE / "prefix", owner.pw_uid, owner.pw_gid)
            etc = RUN / "etc"
            if etc.exists():
                shutil.rmtree(etc)
            source_etc = mount / "etc"
            if not source_etc.is_dir():
                source_etc = mount / "usr/share/factory/etc"
            shutil.copytree(source_etc, etc, symlinks=True)
            for name in ["passwd", "group", "shadow", "machine-id"]:
                path = etc / name
                if path.is_symlink():
                    content = path.read_bytes()
                    path.unlink()
                    path.write_bytes(content)
            sync_accounts(etc, users)
            # This machine runs clients, not nested OCI engines. Producer UID
            # 1001 subordinate mappings must not survive host-account cutover.
            atomic_text(etc / "subuid", "")
            atomic_text(etc / "subgid", "")
            machine_id = STATE / "machine-id"
            if not machine_id.exists():
                import uuid
                atomic_text(machine_id, uuid.uuid4().hex + "\n")
            atomic_text(etc / "machine-id", machine_id.read_text())
            guest_var = STATE / "guest-var"
            if not guest_var.exists():
                shutil.copytree(mount / "var", guest_var, symlinks=True)
            trusted(guest_var)
            linger = guest_var / "lib/systemd/linger"
            if linger.is_dir():
                current_names = {user.pw_name for user in users}
                for entry in linger.iterdir():
                    if entry.name not in current_names:
                        entry.unlink()
        finally:
            run("systemd-dissect", "--umount", str(mount))
    bootstrap = Path("/usr/lib/bluefin-homebrew/guest")
    service = RUN / "etc/systemd/system/bluefin-homebrew-guest.service"
    service.parent.mkdir(parents=True, exist_ok=True)
    shutil.copyfile(bootstrap / "bluefin-homebrew-guest.service", service)
    target = service.parent / "multi-user.target.wants"
    target.mkdir(parents=True, exist_ok=True)
    (target / service.name).unlink(missing_ok=True)
    (target / service.name).symlink_to("../" + service.name)
    for user in users:
        properties = "[Service]\nNoNewPrivileges=yes\n"
        if user.pw_uid != owner.pw_uid:
            properties += "ReadOnlyPaths=/home/linuxbrew/.linuxbrew\n"
        atomic_text(service.parent / f"user@{user.pw_uid}.service.d/bluefin-homebrew.conf", properties)
    atomic_text(RUN / "etc/bluefin-homebrew-users", "".join(f"{u.pw_name}:{u.pw_uid}\n" for u in users))
    roots = []
    binds = [f"Bind={STATE}/prefix:/home/linuxbrew/.linuxbrew", f"Bind={RUN}/etc:/etc",
             f"Bind={STATE}/guest-var:/var", f"BindReadOnly={bootstrap}:/usr/lib/bluefin-homebrew/guest",
             f"BindReadOnly={runtime_config}:/etc/bluefin-homebrew"]
    projects = config.get("PROJECT_ROOTS", "").split()
    for user in users:
        home = os.path.realpath(user.pw_dir)
        if (home in {"/", "/home", "/var/home"} or home == "/root" or home.startswith("/root/")
                or not Path(home).is_dir()):
            raise ValueError(f"Invalid shared home for {user.pw_name}")
        roots.append(f"{user.pw_uid}:{home}\n")
        binds.append(nspawn_bind(home, home))
        if user.pw_dir != home:
            binds.append(nspawn_bind(home, user.pw_dir))
        for engine in ["podman", "docker"]:
            binds.append(pin_endpoint(user, engine))
    for project in projects:
        project = os.path.realpath(project)
        if (project in {"/", "/home", "/var/home", "/var"}
                or any(project == root or project.startswith(root + "/")
                       for root in ["/root", "/run", "/etc", "/usr", "/proc", "/sys", "/dev"])):
            raise ValueError("Only explicit project subdirectories may be shared")
        if not Path(project).is_dir():
            raise ValueError(f"Shared project does not exist: {project}")
        roots.append(f"*:{project}\n")
        binds.append(nspawn_bind(project, project))
    atomic_text(RUN / "roots", "".join(roots))
    atomic_text(RUN / "owner", f"{owner.pw_uid}:{owner.pw_gid}\n")
    atomic_text(RUN / "etc/bluefin-homebrew-owner", f"{owner.pw_uid}\n")
    atomic_text(Path("/run/systemd/nspawn/bluefin-homebrew.nspawn"),
                "[Exec]\nBoot=yes\nPrivateUsers=identity\nNotifyReady=yes\nResolvConf=replace-host\n"
                "[Network]\nPrivate=no\nVirtualEthernet=no\n[Files]\nReadOnly=yes\nVolatile=overlay\n" + "\n".join(binds) + "\n")
    refresh_commands(STATE / "prefix", STATE / "commands", "/usr/libexec/bluefin-homebrew-command")


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--refresh", action="store_true")
    parser.add_argument("--owner-only", action="store_true")
    args = parser.parse_args()
    if os.getuid() != 0:
        parser.error("runtime preparation is root-only")
    STATE.mkdir(mode=0o755, parents=True, exist_ok=True)
    trusted(STATE)
    (STATE / "commands").mkdir(mode=0o755, exist_ok=True)
    trusted(STATE / "commands")
    with (STATE / "lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if args.refresh:
            refresh_commands(STATE / "prefix", STATE / "commands", "/usr/libexec/bluefin-homebrew-command")
        elif args.owner_only:
            owner = select_owner(configuration())
            record_owner(STATE, owner.pw_uid, owner.pw_gid)
        else:
            prepare_machine()


if __name__ == "__main__":
    main()
