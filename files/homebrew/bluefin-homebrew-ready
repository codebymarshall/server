#!/usr/bin/bash
set -euo pipefail
for ((attempt=0; attempt<60; attempt++)); do
    if systemd-run --machine=bluefin-homebrew --pipe --wait --quiet --expand-environment=no \
        /usr/bin/test -f /run/bluefin-homebrew.ready 2>/dev/null; then
        exit 0
    fi
    sleep 1
done
echo 'Homebrew guest user managers failed to become ready' >&2
exit 1
