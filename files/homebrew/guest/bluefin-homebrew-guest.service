[Unit]
Description=Prepare persistent Homebrew guest user managers
After=systemd-logind.service systemd-user-sessions.service
Requires=systemd-logind.service
Before=multi-user.target

[Service]
Type=oneshot
ExecStart=/usr/bin/bash /usr/lib/bluefin-homebrew/guest/bootstrap
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
