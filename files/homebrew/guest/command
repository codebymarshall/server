#!/usr/bin/bash
set -euo pipefail
[[ $EUID -ne 0 ]] || { echo 'Homebrew commands cannot run as root' >&2; exit 126; }
command=${1:?missing command}
shift
[[ -n $command && $command != */* && $command != . && $command != .. ]] || exit 126
export HOMEBREW_NO_AUTO_UPDATE=1 HOMEBREW_NO_INSTALL_CLEANUP=1
export HOMEBREW_PREFIX=/home/linuxbrew/.linuxbrew
export HOMEBREW_CELLAR=$HOMEBREW_PREFIX/Cellar
export HOMEBREW_REPOSITORY=$HOMEBREW_PREFIX/Homebrew
export PATH="$HOMEBREW_PREFIX/bin:$HOMEBREW_PREFIX/sbin:/usr/bin:/usr/sbin"
# Root-owned environment data, never shell source, for explicitly selected host
# runtimes. Caller engine overrides remain usable inside a guest multiplexer.
for file in /etc/bluefin-homebrew/runtime.env "/etc/bluefin-homebrew/runtime.$EUID.env"; do
    [[ -f $file ]] || continue
    while IFS= read -r assignment || [[ -n $assignment ]]; do
        [[ -z $assignment || $assignment == \#* ]] && continue
        [[ $assignment =~ ^(DOCKER_HOST|CONTAINER_HOST|DOCKER_CONFIG|CONTAINERS_CONF|CONTAINERS_STORAGE_CONF|DOCKER_CONTEXT)= ]] || {
            echo "Unsupported engine environment assignment in $file" >&2; exit 126;
        }
        variable=${assignment%%=*}
        # shellcheck disable=SC2163 # assignment is NAME=value, exported as such
        [[ -v $variable ]] || export "$assignment"
    done < "$file"
done
# Home defaults to the caller's rootless Podman API. A missing/unauthorized
# endpoint must fail connection, never start a nested engine in this machine.
# The trusted per-UID Docker opt-in above overrides only Docker's endpoint.
export CONTAINER_HOST=${CONTAINER_HOST:-unix:///run/bluefin-engines/$EUID/podman/api.sock}
export DOCKER_HOST=${DOCKER_HOST:-unix:///run/bluefin-engines/$EUID/podman/api.sock}
case $command in
    brew)
        read -r owner </etc/bluefin-homebrew-owner
        [[ $EUID == "$owner" ]] || { echo 'Only the configured owner may change Homebrew packages' >&2; exit 126; }
        executable=$HOMEBREW_PREFIX/bin/brew
        ;;
    *)
        if [[ -f $HOMEBREW_PREFIX/bin/$command && -x $HOMEBREW_PREFIX/bin/$command ]]; then
            executable=$HOMEBREW_PREFIX/bin/$command
        elif [[ -f $HOMEBREW_PREFIX/sbin/$command && -x $HOMEBREW_PREFIX/sbin/$command ]]; then
            executable=$HOMEBREW_PREFIX/sbin/$command
        else
            printf 'No installed guest command: %s\n' "$command" >&2
            exit 127
        fi
        ;;
esac
exec "$executable" "$@"
