[Unit]
Description=Track command links installed inside Homebrew
# Path units precede paths.target/basic.target; preparation and nspawn run later.
# Watch before seeding; the refresh service waits for preparation to finish.

[Path]
PathChanged=/var/lib/bluefin-homebrew/prefix/bin
PathChanged=/var/lib/bluefin-homebrew/prefix/sbin
Unit=bluefin-homebrew-commands.service

[Install]
WantedBy=bluefin-homebrew.service
