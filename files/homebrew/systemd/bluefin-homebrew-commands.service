[Unit]
Description=Refresh root-owned guest command index
After=bluefin-homebrew-prepare.service
# Brew links many executables in one transaction; this event-driven oneshot
# must not latch the watcher failed after five successful refreshes.
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=/usr/libexec/bluefin-homebrew-prepare --refresh
