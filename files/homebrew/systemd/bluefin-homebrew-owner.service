[Unit]
Description=Set up the nonroot Homebrew owner before console login
Requires=bluefin-homebrew-image.service
After=systemd-sysusers.service systemd-tmpfiles-setup.service local-fs.target bluefin-homebrew-image.service
Before=bluefin-homebrew-prepare.service getty@tty1.service
ConditionPathExists=!/var/lib/bluefin-homebrew/owner

[Service]
Type=oneshot
ExecStart=/usr/libexec/bluefin-homebrew-prepare --owner-only
RemainAfterExit=yes
ImportCredential=bluefin.homebrew.*
ImportCredential=passwd.hashed-password.*
ImportCredential=ssh.authorized_keys.*
StandardInput=tty
StandardOutput=journal+console
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TimeoutStartSec=infinity
UMask=0022
