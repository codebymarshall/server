[Unit]
Description=Prepare the Homebrew machine and persistent prefix
Requires=bluefin-homebrew-owner.service
After=systemd-sysusers.service systemd-tmpfiles-setup.service local-fs.target bluefin-homebrew-owner.service
Before=bluefin-homebrew.service getty@tty1.service
ConditionPathExists=/var/lib/machines/bluefin-homebrew.raw

[Service]
Type=oneshot
ExecStart=/usr/libexec/bluefin-homebrew-prepare
RemainAfterExit=yes
ImportCredential=bluefin.homebrew.*
ImportCredential=passwd.hashed-password.*
ImportCredential=ssh.authorized_keys.*
TimeoutStartSec=infinity
UMask=0022
