[Unit]
Description=Bluefin Homebrew system container
Requires=bluefin-homebrew-prepare.service
Wants=bluefin-oci-owner-prepare.service
After=bluefin-homebrew-prepare.service bluefin-oci-owner-prepare.service network-online.target
# Type=notify and ExecStartPost finish guest user-manager readiness before login.
Before=getty@tty1.service sshd.service
ConditionPathExists=/var/lib/machines/bluefin-homebrew.raw

[Service]
Type=notify
ExecStart=/usr/bin/systemd-nspawn --quiet --keep-unit --boot --machine=bluefin-homebrew --image=/var/lib/machines/bluefin-homebrew.raw --settings=trusted --read-only --volatile=overlay --private-users=identity
ExecStartPost=/usr/libexec/bluefin-homebrew-ready
KillMode=mixed
TimeoutStartSec=180
TimeoutStopSec=60
Restart=on-failure
Delegate=yes
TasksMax=infinity
DeviceAllow=char-pts rw
DeviceAllow=/dev/loop-control rw
DeviceAllow=block-loop rwm
DeviceAllow=block-blkext rwm

[Install]
WantedBy=multi-user.target
