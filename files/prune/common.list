# Pruned from both the /usr image and the initrd (files/prune/prune.sh).
# Only paths that nothing in the image, the initrd, or a shipped sysext links,
# dlopen()s, or executes from a unit or udev rule. `just check-image` enforces
# that for every build; see docs/skills/ddi-installer-build.md.

# Keep ICU shared libraries: shipped libxml2 links them. Remove only its tools/data.
usr/share/icu
usr/bin/derb
usr/bin/escapesrc
usr/bin/genbrk
usr/bin/genccode
usr/bin/gencfu
usr/bin/gencmn
usr/bin/gencnval
usr/bin/gendict
usr/bin/gennorm2
usr/bin/genrb
usr/bin/gensprep
usr/bin/icuexportdata
usr/bin/icuinfo
usr/bin/icupkg
usr/bin/makeconv
usr/bin/pkgdata
usr/bin/uconv
usr/bin/xfs_scrub
usr/bin/xfs_scrub_all
usr/share/xfsprogs/xfs_scrub_all.cron

# GCC runtimes no binary links: Fortran, Objective-C, transactional memory,
# and the sanitizer runtimes.
usr/lib/*-linux-gnu/libgfortran.so*
usr/lib/*-linux-gnu/libobjc.so*
usr/lib/*-linux-gnu/libitm.so*
usr/lib/*-linux-gnu/libasan.so*
usr/lib/*-linux-gnu/libhwasan.so*
usr/lib/*-linux-gnu/liblsan.so*
usr/lib/*-linux-gnu/libtsan.so*
usr/lib/*-linux-gnu/libubsan.so*

# SQLite CLI (gpg keeps libsqlite3) and the GnuPG tools beyond signature
# verification; both trees keep gpg, gpgv, gpg-agent and keyboxd.
usr/bin/sqlite3
usr/bin/gpgsm
usr/bin/gpg-wks-client
usr/bin/gpg-wks-server
usr/bin/gpgtar
usr/bin/gpg-card
usr/bin/gpg-mail-tube
usr/bin/gpgsplit
usr/bin/gpgparsemail
usr/libexec/gpg-wks-client
usr/libexec/scdaemon
